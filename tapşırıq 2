body {
    background: #dcdcdc;
    font-family: Arial, sans-serif;
}

.container {
    width: 80%;
    margin: 40px auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: white;
    padding: 10px;
    border-radius: 5px;
}

.img-box {
    position: relative;
}

.img-box img {
    width: 100%;
    display: block;
}

.img-box button {
    position: absolute;
    right: 10px;
    bottom: 10px;
    background: red;
    color: white;
    border: none;
    padding: 5px 10px;
    cursor: pointer;
}

.info {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
}

.info span {
    color: green;
    font-weight: bold;
}
