<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>Box Model</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="margin">
    Margin

    <div class="border">
        Border

        <div class="padding">
            Padding

            <div class="content">
                Content
            </div>

        </div>
    </div>
</div>

</body>
</html>
body {
    font-family: Arial;
}
.margin {
    border: 2px dashed gray;
    padding: 20px;
    margin: 50px;
    text-align: center;
}
.border {
    background: #179c6b;
    padding: 20px;
    color: black;
}
.padding {
    background: #ddd;
    padding: 30px;
}
.content {
    border: 2px dashed gray;
    padding: 40px;
    background: white;
}
